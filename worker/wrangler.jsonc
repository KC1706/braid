{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braid-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "braid" }
  ],
  "ai": { "binding": "AI" },
  // Phase 3c: the two compute Containers (one braid image, zone chosen by
  // BRAID_ZONE in each class). Both build from the repo-root Dockerfile.
  "containers": [
    // Compute zone compiles + runs the agents' Go tests, so it needs real CPU/RAM
    // (lite = 1/16 vCPU / 256 MiB can't build Go). standard-2 = 1 vCPU / 6 GiB.
    { "class_name": "ComputeZone", "image": "../Dockerfile", "image_build_context": "..", "max_instances": 5, "instance_type": "standard-2" },
    // IO zone only runs git (clone/fetch/CAS-push); basic = 1/4 vCPU / 1 GiB.
    { "class_name": "IOZone", "image": "../Dockerfile", "image_build_context": "..", "max_instances": 5, "instance_type": "basic" }
  ],
  // Phase 3c: the durable consumer that drives one run's two-zone pipeline.
  "workflows": [
    { "name": "braid-integration", "binding": "INTEGRATION_WORKFLOW", "class_name": "IntegrationWorkflow" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ORCHESTRATOR", "class_name": "Orchestrator" },
      { "name": "COMPUTE_ZONE", "class_name": "ComputeZone" },
      { "name": "IO_ZONE", "class_name": "IOZone" },
      { "name": "BASE_COORDINATOR", "class_name": "BaseCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Orchestrator"] },
    { "tag": "v2", "new_sqlite_classes": ["ComputeZone", "IOZone"] },
    { "tag": "v3", "new_sqlite_classes": ["BaseCoordinator"] }
  ],
  "assets": {
    "directory": "../dashboard/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
