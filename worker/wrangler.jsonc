{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braid-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "braid" }
  ],
  "observability": { "enabled": true }
}
